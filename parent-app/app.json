{
  "expo": {
    "name": "ShieldGuard",
    "slug": "shieldguard-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shieldguard.parent"
    },
    "android": {
      "package": "com.shieldguard.parent",
      "adaptiveIcon": {
        "backgroundColor": "#0a1628"
      },
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": ["expo-location", "expo-notifications"]
  }
}