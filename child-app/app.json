{
  "expo": {
    "name": "ShieldGuard Safe",
    "slug": "shieldguard-child",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shieldguard.child"
    },
    "android": {
      "package": "com.shieldguard.child",
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "QUERY_ALL_PACKAGES",
        "CAMERA",
        "READ_PHONE_STATE",
        "READ_CALL_LOG",
        "READ_SMS",
        "RECEIVE_SMS",
        "READ_CONTACTS"
      ]
    },
    "plugins": [
      ["expo-location", {"isAndroidBackgroundLocationEnabled": true, "isAndroidForegroundServiceEnabled": true}],
      "expo-task-manager",
      "expo-notifications"
    ]
  }
}